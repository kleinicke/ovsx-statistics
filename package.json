{
	"name": "extension-downloads",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.10.0",
	"scripts": {
		"dev": "vite build && wrangler pages dev",
		"dev:vite": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "vite build && wrangler pages deploy build --project-name ovsx-statistics",
		"scrape": "tsx scripts/scrape-daily.ts",
		"sweep:vscode": "tsx scripts/sweep-vscode-ids.ts",
		"export:latest": "tsx scripts/export-latest.ts",
		"merge:local": "tsx scripts/merge-local-databases.ts",
		"import:turso": "tsx scripts/import-to-turso.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260726.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.22.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.114.0"
	},
	"dependencies": {
		"@libsql/client": "^0.15.15",
		"bits-ui": "^2.18.1",
		"chart.js": "^4.5.1",
		"clsx": "^2.1.1",
		"dotenv": "^17.2.3",
		"lucide-svelte": "^1.0.1",
		"mode-watcher": "^1.1.0",
		"tailwind-merge": "^3.6.0"
	}
}
